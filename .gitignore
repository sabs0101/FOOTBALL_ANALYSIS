# ==========================================
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# ==========================================
# Large ML Weights & Model Checkpoints
# ==========================================
*.pt
*.pth
*.onnx
*.engine
*.tflite
models/*
!models/.gitkeep

# ==========================================
# Video Datasets & Processed Media Outputs
# ==========================================
data/videos/*
!data/videos/.gitkeep
data/test/*
!data/test/.gitkeep
!data/test/sample_frame.jpg
!data/test/sample_annotations.json
data/uploads/*
!data/uploads/.gitkeep
outputs/*
!outputs/.gitkeep
outputs/detections/*
!outputs/detections/.gitkeep
outputs/logs/*
!outputs/logs/.gitkeep

# Ignore raw video formats anywhere in repo
*.mp4
*.avi
*.mov
*.mkv

# Ultralytics auto-downloads & run logs
runs/
*.yolo

# ==========================================
# IDE & System Files
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~
